@article{WOODHOUSE:98:LinearDamping,
title = {LINEAR DAMPING MODELS FOR STRUCTURAL VIBRATION},
journal = {Journal of Sound and Vibration},
volume = {215},
number = {3},
pages = {547-569},
year = {1998},
issn = {0022-460X},
doi = {https://doi.org/10.1006/jsvi.1998.1709},
url = {https://www.sciencedirect.com/science/article/pii/S0022460X98917096},
author = {J. Woodhouse},
abstract = {Linear damping models for structural vibration are examined: first the familiar dissipation-matrix model, then the general linear model. In both cases, an approximation of small damping is used to obtain simple expressions for damped natural frequencies, complex mode shapes, and transfer functions. Results for transfer functions can be expressed in the form of very direct extensions of the familiar expression for the undamped case. This allows a detailed discussion of the implications of the various damping models for the interpretation of measured transfer functions, especially in the context of experimental modal analysis. In the case of a dissipation-matrix model, it would be possible in principle to determine all the model parameters from measurements. In the case of the general model, however, there is a fundamental ambiguity which prevents full determination of the model from measurements on a single structure.}
}

@article{ADHIKARI:07:Damping,
title = {On the quantification of damping model uncertainty},
journal = {Journal of Sound and Vibration},
volume = {306},
number = {1},
pages = {153-171},
year = {2007},
issn = {0022-460X},
doi = {https://doi.org/10.1016/j.jsv.2007.05.022},
url = {https://www.sciencedirect.com/science/article/pii/S0022460X07003811},
author = {S. Adhikari},
abstract = {The characterization of uncertainty in the damping forces in a vibrating structure is of significant interest in structural dynamics. The most common approach is to use a viscous damping matrix with uncertain coefficients. The viscous damping is not the only damping model within the scope of linear analysis. Any model which makes the energy dissipation functional non-negative is a possible candidate for a valid damping model. There are many functional forms which can be used as damping models. In this paper, two approaches are proposed to quantify such ‘model-form uncertainty’ associated with the use of the viscous damping model (not only the model parameters). The first approach is based on an ensemble of equivalent damping functions and the second approach is based on the random matrix theory. The results obtained from the two methods are compared using numerical examples. It was observed that the random matrix theory can be used to quantify damping model uncertainty in some cases.}
}

